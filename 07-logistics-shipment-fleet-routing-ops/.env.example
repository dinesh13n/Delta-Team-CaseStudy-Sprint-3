# Placeholder-only configuration (F-10, F-11, F-12, F-13). Copy to .env (git-ignored) and fill real values locally.
# Never commit real values. Production values come from the platform secret store, not from files.
APP_ENV=local
AUTH_MODE=hs256
# At least 32 random characters, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
LOG_LEVEL=INFO
# Optional switches (see docs/14-transformation/feature-flag-plan.md): LOOKUP_MODE, DATA_LAYER, AI_PROVIDER, AI_ENABLED
