icalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="522" y="444" width="226" height="110" as="geometry"/></mxCell><mxCell id="p0-c3" value="&lt;b&gt;Fallback, then abstain&lt;/b&gt;&lt;br&gt;never an invalid answer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="276" y="444" width="226" height="110" as="geometry"/></mxCell><mxCell id="p0-c4" value="&lt;b&gt;Register suggestion&lt;/b&gt;&lt;br&gt;human approval required" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="30" y="444" width="226" height="110" as="geometry"/></mxCell><mxCell id="p0-d0" value="&lt;b&gt;Audit event&lt;/b&gt;&lt;br&gt;hash-chained" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="30" y="609" width="226" height="110" as="geometry"/></mxCell><mxCell id="p0-d1" value="&lt;b&gt;Person decides&lt;/b&gt;&lt;br&gt;approve or reject, once" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E5F3EB;strokeColor=#2E8B57;fontColor=#1E5631;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="276" y="609" width="226" height="110" as="geometry"/></mxCell><mxCell id="p0-d2" value="&lt;b&gt;A second decision&lt;/b&gt;&lt;br&gt;refused (409)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="522" y="609" width="226" he