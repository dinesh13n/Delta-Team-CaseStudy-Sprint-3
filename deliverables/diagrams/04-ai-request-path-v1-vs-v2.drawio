<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="04-ai-request-path-v1-vs-v2"><mxGraphModel dx="1280" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="784" math="0" shadow="0"><root><mxCell id="p0-0"/><mxCell id="p0-1" parent="p0-0"/><mxCell id="p0-title" value="One AI summary request, before and after" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#0B3C49;align=left;verticalAlign=middle;" vertex="1" parent="p0-1"><mxGeometry x="12" y="10" width="1256" height="44" as="geometry"/></mxCell><mxCell id="p0-l1" value="&lt;b&gt;Repo 1.0&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3F7F8;strokeColor=#C5D6DA;fontColor=#0B3C49;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="p0-1"><mxGeometry x="10" y="74" width="1260" height="165" as="geometry"/></mxCell><mxCell id="p0-a0" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;no identity needed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="30" y="114" width="226" height="100" as="geometry"/></mxCell><mxCell id="p0-a1" value="&lt;b&gt;Summary&lt;/b&gt;&lt;br&gt;echo of the first column" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="276" y="114" width="226" height="100" as="geometry"/></mxCell><mxCell id="p0-a2" value="&lt;b&gt;Guardrail&lt;/b&gt;&lt;br&gt;not_enforced" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="522" y="114" width="226" height="100" as="geometry"/></mxCell><mxCell id="p0-a3" value="&lt;b&gt;Audit line&lt;/b&gt;&lt;br&gt;no actor, no correlation&lt;br&gt;id" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="768" y="114" width="226" height="100" as="geometry"/></mxCell><mxCell id="p0-a4" value="&lt;b&gt;Response used&lt;/b&gt;&lt;br&gt;no approval step" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="1014" y="114" width="226" height="100" as="geometry"/></mxCell><mxCell id="p0-l2" value="&lt;b&gt;Repo 2.0&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3F7F8;strokeColor=#C5D6DA;fontColor=#0B3C49;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="p0-1"><mxGeometry x="10" y="254" width="1260" height="520" as="geometry"/></mxCell><mxCell id="p0-b0" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;with a bearer token" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="30" y="294" width="226" height="100" as="geometry"/></mxCell><mxCell id="p0-b1" value="&lt;b&gt;Verify token&lt;/b&gt;&lt;br&gt;else 401" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="276" y="294" width="226" height="100" as="geometry"/></mxCell><mxCell id="p0-b2" value="&lt;b&gt;Policy check&lt;/b&gt;&lt;br&gt;persona, entity,&lt;br&gt;purpose; else 403" style="rounded=1;ar