<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="07-semantic-layer-rebuild"><mxGraphModel dx="1280" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="784" math="0" shadow="0"><root><mxCell id="p0-0"/><mxCell id="p0-1" parent="p0-0"/><mxCell id="p0-title" value="Can the semantic layer rebuild the system on its own?" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#0B3C49;align=left;verticalAlign=middle;" vertex="1" parent="p0-1"><mxGeometry x="12" y="10" width="1256" height="44" as="geometry"/></mxCell><mxCell id="p0-l_build" value="&lt;b&gt;Step 1: rebuild from the semantic layer alone&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3F7F8;strokeColor=#C5D6DA;fontColor=#0B3C49;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="p0-1"><mxGeometry x="10" y="74" width="1260" height="250" as="geometry"/></mxCell><mxCell id="p0-in" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;semantic-layer/ only:&lt;br&gt;21 files from commit&lt;br&gt;a6fc839" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2A541;strokeColor=#C98118;fontColor=#1B1B1B;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="30" y="134" width="222" height="150" as="geometry"/></mxCell><mxCell id="p0-ag" value="&lt;b&gt;Blind builder agent&lt;/b&gt;&lt;br&gt;reads nothing else; all&lt;br&gt;57 actions audited" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0B3C49;strokeColor=#0B3C49;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="278" y="134" width="222" height="150" as="geometry"/></mxCell><mxCell id="p0-prd" value="&lt;b&gt;PRD&lt;/b&gt;&lt;br&gt;10 API operations, 5&lt;br&gt;workflows, each cited&lt;br&gt;to the layer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="526" y="134" width="222" height="150" as="geometry"/></mxCell><mxCell id="p0-app" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;own synthetic data; 175&lt;br&gt;tests pass" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="774" y="134" width="222" height="150" as="geometry"/></mxCell><mxCell id="p0-gap" value="&lt;b&gt;GAPS.md&lt;/b&gt;&lt;br&gt;67 assumptions, 17 not&lt;br&gt;buildable, 24 layer&lt;br&gt;defects" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="1022" y="134" width="222" height="150" as="geometry"/></mxCell><mxCell id="p0-l_cmp" value="&lt;b&gt;Step 2: the same probes against both applications&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3F7F8;strokeColor=#C5D6DA;fontColor=#0B3C49;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="p0-1"><mxGeometry x="10" y="344" width="1260" height="190" as="geometry"/></mxCell><mxCell id="p0-orig" value="&lt;b&gt;Original application&lt;/b&gt;&lt;br&gt;Repo 2.0 as built" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="30" y="394" width="300" height="110" as="geometry"/></mxCell><mxCell id="p0-reb" value="&lt;b&gt;Rebuilt application&lt;/b&gt;&lt;br&gt;from the layer only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="950" y="394" width="300" height="110" as="geometry"/></mxCell><mxCell id="p0-probe" value="&lt;b&gt;Probe script&lt;/b&gt;&lt;br&gt;30 HTTP checks, plus the AI decision for every&lt;br&gt;shipment, on each app&amp;#x27;s data and on swapped data" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0B3C49;strokeColor=#0B3C49;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="400" y="384" width="480" height="130" as="geometry"/></mxCell><mxCell id="p0-l_res" value="&lt;b&gt;Step 3: what came back&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3F7F8;strokeColor=#C5D6DA;fontColor=#0B3C49;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="p0-1"><mxGeometry x="10" y="554" width="1260" height="220" as="geometry"/></mxCell><mxCell id="p0-r0" value="&lt;b&gt;Status codes&lt;/b&gt;&lt;br&gt;29 of 30 match" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E5F3EB;strokeColor=#2E8B57;fontColor=#1E5631;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="30" y="604" width="222" height="140" as="geometry"/></mxCell><mxCell id="p0-r1" value="&lt;b&gt;AI decisions&lt;/b&gt;&lt;br&gt;41 of 41 agree on the&lt;br&gt;same data" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E5F3EB;strokeColor=#2E8B57;fontColor=#1E5631;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="278" y="604" width="222" height="140" as="geometry"/></mxCell><mxCell id="p0-r2" value="&lt;b&gt;AI response fields&lt;/b&gt;&lt;br&gt;the same 19" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E5F3EB;strokeColor=#2E8B57;fontColor=#1E5631;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="526" y="604" width="222" height="140" as="geometry"/></mxCell><mxCell id="p0-r3" value="&lt;b&gt;Original data&lt;/b&gt;&lt;br&gt;0 of 354 rows accepted&lt;br&gt;(original: 349)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p0-1"><mxGeometry x="774" y="604" width="222" height="140" as="geometry"/></mxCell><mxCell id="p0-r4" value="&lt;b&gt;Not rebuilt&lt;/b&gt;&lt;br&gt;CI, Docker, policy&lt;br&gt;file, web view" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5A8;fontColor=#5F6E71;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="p0-1"><mxGeometry x="1022" y="604" width="222" height="140" as="geometry"/></mxCell><mxCell id="p0-e0" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#41545A;strokeWidth=2;" edge="1" parent="p0-1" source="p0-in" target="p0-ag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-e1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#41545A;strokeWidth=2;" edge="1" parent="p0-1" source="p0-ag" target="p0-prd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-e2" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#41545A;strokeWidth=2;" edge="1" parent="p0-1" source="p0-prd" target="p0-app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-e3" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#41545A;strokeWidth=2;" edge="1" parent="p0-1" source="p0-app" target="p0-gap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-e4" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#41545A;strokeWidth=2;" edge="1" parent="p0-1" source="p0-orig" target="p0-probe"><mxGeometry relative="1" as="geometry"/></mxCell><mx