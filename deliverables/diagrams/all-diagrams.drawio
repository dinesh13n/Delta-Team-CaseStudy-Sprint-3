" height="100" as="geometry"/></mxCell><mxCell id="p3-l2" value="&lt;b&gt;Repo 2.0&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3F7F8;strokeColor=#C5D6DA;fontColor=#0B3C49;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="p3-1"><mxGeometry x="10" y="254" width="1260" height="520" as="geometry"/></mxCell><mxCell id="p3-b0" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;with a bearer token" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-1"><mxGeometry x="30" y="294" width="226" height="100" as="geometry"/></mxCell><mxCell id="p3-b1" value="&lt;b&gt;Verify token&lt;/b&gt;&lt;br&gt;else 401" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-1"><mxGeometry x="276" y="294" width="226" height="100" as="geometry"/></mxCell><mxCell id="p3-b2" value="&lt;b&gt;Policy check&lt;/b&gt;&lt;br&gt;persona, entity,&lt;br&gt;purpose; else 403" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-1"><mxGeometry x="522" y="294" width="226" height="100" as="geometry"/></mxCell><mxCell id="p3-b3" value="&lt;b&gt;Key pattern&lt;/b&gt;&lt;br&gt;else 422" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F7A8C;fontColor=#0B3C49;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-1"><mxGeometry x="768" y="294" width="226" height="100" as="geometry"/></mxCell><mxCell id="p3-b4" value="&lt;b&gt;Rate limit&lt;/b&gt;&lt;br&gt;else 429" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFF