ometry"/></mxCell><mxCell id="p1-ai" value="&lt;b&gt;AI gateway&lt;/b&gt;&lt;br&gt;no auth;&lt;br&gt;guardrail not&lt;br&gt;enforced" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p1-1"><mxGeometry x="225" y="254" width="120" height="160" as="geometry"/></mxCell><mxCell id="p1-audit" value="&lt;b&gt;Audit writer&lt;/b&gt;&lt;br&gt;no actor, no&lt;br&gt;correlation&lt;br&gt;id" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p1-1"><mxGeometry x="360" y="254" width="120" height="160" as="geometry"/></mxCell><mxCell id="p1-dom" value="&lt;b&gt;Record lookup&lt;/b&gt;&lt;br&gt;any column; a&lt;br&gt;row even on a&lt;br&gt;miss" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p1-1"><mxGeometry x="495" y="254" width="120" height="160" as="geometry"/></mxCell><mxCell id="p1-l_leg" value="&lt;b&gt;Generation 1: legacy batch&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3F7F8;strokeColor=#C5D6DA;fontColor=#0B3C49;fontSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="p1-1"><mxGeometry x="205" y="529" width="430" height="245" as="geometry"/></mxCell><mxCell id="p1-rec" value="&lt;b&gt;reconcile_legacy.py&lt;/b&gt;&lt;br&gt;counts rows; hard-coded credential" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEA;strokeColor=#C0392B;fontColor=#7B241C;fontSize=15;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p1-1"><mxGeometry x="225" y="569" width="390" height="80" as="geometry"/></mxCell><mxCell id="p1-etl" val